{
  "name": "the-villager-rebuild",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/run-pwa-icon-generator.mjs dist/icons",
    "preview": "vite preview --host 0.0.0.0",
    "verify:assets": "node scripts/verify-runtime-assets.mjs public",
    "verify:gameplay": "node scripts/verify-gameplay.mjs",
    "verify:construction": "node scripts/verify-construction-refinement.mjs",
    "verify:walls": "node scripts/verify-wall-customization.mjs",
    "verify:roof": "node scripts/verify-roof-topology.mjs",
    "verify:roof-runtime": "node scripts/verify-roof-preview-runtime.mjs",
    "verify:harvesting": "node scripts/verify-tree-harvest.mjs",
    "verify:tree-shake": "node scripts/verify-tree-hit-shake.mjs",
    "verify:device-regressions": "node scripts/verify-device-regressions-0.3.11.mjs",
    "verify:thatch-interior": "node scripts/verify-thatch-interior-occlusion.mjs",
    "verify:mobile-action": "node scripts/verify-mobile-context-action.mjs",
    "verify:animals": "node scripts/verify-animal-behavior.mjs",
    "verify:survival": "node scripts/verify-survival-interactions.mjs",
    "verify:campfire": "node scripts/verify-campfire.mjs",
    "verify:landscape": "node scripts/verify-landscape.mjs",
    "verify:streaming": "node scripts/verify-world-streaming.mjs",
    "verify:dist-assets": "node scripts/verify-runtime-assets.mjs dist",
    "verify:pwa": "node scripts/verify-pwa.mjs dist",
    "check": "npm run verify:assets && npm run verify:gameplay && npm run verify:construction && npm run verify:walls && npm run verify:roof && npm run verify:roof-runtime && npm run verify:harvesting && npm run verify:tree-shake && npm run verify:device-regressions && npm run verify:thatch-interior && npm run verify:mobile-action && npm run verify:animals && npm run verify:survival && npm run verify:campfire && npm run verify:landscape && npm run verify:streaming && npm run build && npm run verify:dist-assets && npm run verify:pwa"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "vite": "7.1.3"
  }
}
